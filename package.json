{
  "name": "@digestengine/marketing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.8.0",
    "pnpm": ">=11.1.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "postbuild": "next-sitemap --config sitemap.config.mjs",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:code && npm run lint:style",
    "lint:code": "eslint . --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.css\"",
    "lint:fix": "npm run lint:code:fix && npm run lint:style:fix",
    "lint:code:fix": "eslint . --fix",
    "lint:style:fix": "stylelint \"src/**/*.css\" --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@microsoft/clarity": "^1.0.2",
    "@next/third-parties": "16.3.3",
    "@portabletext/markdown": "^2.2.0",
    "@portabletext/react": "^8.0.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/nextjs": "^10.74.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "logrocket": "^12.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.3",
    "next-sanity": "^13.3.4",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}